1:["$","$La",null,{"current":"meetings","children":["$","main",null,{"className":"rux-workspace","aria-label":"Bamboo Production Order Walkthrough","children":["$","div",null,{"className":"rux-workspace__body","children":["$","div",null,{"className":"ln-container","children":["$","article",null,{"className":"ln-sop","children":[["$","section",null,{"className":"page-head","children":[["$","p",null,{"className":"eyebrow","children":"Session Summary"}],["$","h1",null,{"children":"Bamboo Production Order Walkthrough"}],["$","p",null,{"children":"The bamboo training items taken through a production order end to end, on master data built for the purpose rather than inherited from demo data."}]]}],["$","div",null,{"className":"ln-sop__meta","children":[["$","div",null,{"className":"ln-sop__meta-item","children":[["$","span",null,{"children":"Session Date"}],["$","strong",null,{"children":"2026-08-18"}]]}],["$","div",null,{"className":"ln-sop__meta-item","children":[["$","span",null,{"children":"Type"}],["$","strong",null,{"children":"Training Session"}]]}]]}],["$","div",null,{"className":"ln-sop__note","children":[["$","strong",null,{"children":"Orientation only."}]," This is the shareable half of a longer internal record. It carries no citations, and nothing here should be relied on for implementation work without checking it against official Infor documentation."]}],[["$","h2","0",{"children":"What this covered"}],["$","p","1",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Taking the bamboo training items (a rod, a sleeve, and a finished chopstick pair) all the way from bare item records to a produced, received finished good — building the bill of material, the routing, the cost, and the stock the production order needed, then running that order to completion."}]]}]]}],["$","h2","2",{"children":"Topics"}],["$","h3","3",{"children":"Building the recipe: bill of material and routing"}],["$","p","4",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"The chopstick pair needs a bill of material (what goes into it) and a routing (the steps to make it). Both were built from scratch."}]]}]]}],["$","p","5",{"children":[["$","strong","0",{"children":"What was shown:"}]]}],["$","ol","6",{"children":[["$","li","0",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Job Shop Bill of Material — created BOM "}]]}],["$","code","1",{"children":"JB0000242"}],["$","$b","2",{"children":[["$","$b","0",{"children":" for the chopstick pair: 2 rods, 1 sleeve."}]]}]]}],["$","li","1",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Job Shop Routing — one cutting operation, at work center "}]]}],["$","code","1",{"children":"A1000"}],["$","$b","2",{"children":[["$","$b","0",{"children":"."}]]}]]}],["$","li","2",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Later, a second BOM revision was created on purpose, just to show how revisions work: create the new one, approve it, then mark the old one \"expired\" so the system switches over automatically."}]]}]]}]]}],["$","h3","7",{"children":"Costing the item"}],["$","p","8",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Before you can produce something, LN needs to know what it costs. This turned out to be simpler than expected — it's a button right on the item's own screen ("}]]}],["$","strong","1",{"children":"Calculate and Actualize Standard Costs"}],["$","$b","2",{"children":[["$","$b","0",{"children":"), not a separate session."}]]}]]}],["$","h3","9",{"children":"Getting materials on hand — the purchasing route"}],["$","p","10",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"The rod and sleeve had to physically be in the warehouse before production could use them. The team bought them from an existing test supplier (Vista Machines Inc.) rather than just adjusting inventory by hand — a real purchase order, all the way through to a warehouse receipt."}]]}]]}],["$","p","11",{"children":[["$","strong","0",{"children":"What was shown:"}]]}],["$","ol","12",{"children":[["$","li","0",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Created a purchase order for 2 rods and 1 sleeve."}]]}]]}],["$","li","1",{"children":"$Lc"}]]}],"$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]]}]}]}]}]}]
c:[["$","$b","0",{"children":[["$","$b","0",{"children":"Hit a real system error on receiving (\"Stock Point Details not found\") — worked through it and the receipt still closed out successfully."}]]}]]
d:["$","h3","13",{"children":"Running the production order"}]
e:["$","p","14",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"With the recipe, cost, and materials all in place, the order ran start to finish: created, released, materials issued, operation completed, and the finished pair received into the warehouse — with an inspection step in between."}]]}]]}]
f:["$","p","15",{"children":[["$","strong","0",{"children":"What was shown:"}]]}]
10:["$","ol","16",{"children":[["$","li","0",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Production order created and released."}]]}]]}],["$","li","1",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Materials issued to the shop floor."}]]}]]}],["$","li","2",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Finished pair inspected, then the order closed — closing it required both the materials being fully issued *and* the finished item being fully put away, not just received."}]]}]]}]]}]
11:["$","h2","17",{"children":"What was decided"}]
12:["$","ol","18",{"children":[["$","li","0",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Buying components in through a real purchase order is the standard way to stock these training items — not manually adjusting inventory."}]]}]]}],["$","li","1",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Vista Machines Inc. is the go-to test supplier for this kind of purchase."}]]}]]}],["$","li","2",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Closing out a production order stays a separate, later step — not part of the standard walkthrough, even though it was demonstrated here."}]]}]]}]]}]
13:["$","h2","19",{"children":"Key takeaways"}]
14:["$","ul","20",{"children":[["$","li","0",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Standard costing lives on the item screen itself as an action, not a separate costing session."}]]}]]}],["$","li","1",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"A BOM revision doesn't take effect until the old one is expired — approve the new one, then expire the old one."}]]}]]}],["$","li","2",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Closing a production order needs everything finished on both sides: materials fully issued out, and the finished item fully put away, not just received."}]]}]]}],["$","li","3",{"children":[["$","$b","0",{"children":[["$","$b","0",{"children":"Real errors happen even on a \"known good\" path (the stock-point error on receipt) — and the system can still recover and complete normally."}]]}]]}]]}]
