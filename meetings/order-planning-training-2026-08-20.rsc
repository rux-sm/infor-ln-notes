31:["$","ul","44",{"children":[["$","li","0",{"children":[["$","strong","0",{"children":"An item with no planning data is invisible to planning"}],["$","$b","1",{"children":[["$","$b","0",{"children":" — not an error, just absent. Check the Item Order Plan first when MRP ignores something."}]]}]]}],["$","li","1",{"children":[["$","strong","0",{"children":"The order horizon is the single setting that decides whether planning sees a demand at all."}],["$","$b","1",{"children":[["$","$b","0",{"children":" If MRP is ignoring a real order, check the horizon before anything else."}]]}]]}],["$","li","2",{"children":[["$","strong","0",{"children":"MRP only plans components that have their own planning data."}],["$","$b","1",{"children":[["$","$b","0",{"children":" A parent can plan cleanly while its components are silently skipped."}]]}]]}],["$","li","3",{"children":[["$","strong","0",{"children":"Planned orders are suggestions, not instructions."}],["$","$b","1",{"children":[["$","$b","0",{"children":" The planner's knowledge of suppliers and lead times is expected to override them."}]]}]]}],["$","li","4",{"children":[["$","strong","0",{"children":"Pegging is how you make sense of a multi-level result"}],["$","$b","1",{"children":[["$","$b","0",{"children":" — upstream for what will supply a demand, downstream for what caused an order."}]]}]]}],["$","li","5",{"children":[["$","strong","0",{"children":"After any master-data change, close and reopen the session"}],["$","$b","1",{"children":[["$","$b","0",{"children":" before expecting LN to see it."}]]}]]}]]}]
